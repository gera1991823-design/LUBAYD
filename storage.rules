rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    match /breaks/{uid}/{recordId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && validImage();
      allow delete: if false;
    }

    match /parts/{uid}/{partId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && validImage();
      allow delete: if false;
    }

    match /services/{uid}/{serviceId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && validImage();
      allow delete: if false;
    }

    match /fuel/{uid}/{loadId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && validImage();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
