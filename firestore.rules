rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }

    function isMechanic() {
      return hasProfile() && profile().role == 'mechanic';
    }

    function isMechanicOrAdmin() {
      return isMechanic() || isAdmin();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'operator';

      allow read: if isOwner(userId)
                  || isAdmin()
                  || (hasProfile() && profile().active == true);

      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.role == resource.data.role);

      allow delete: if false;

      match /breaks/{breakId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if false;
      }

      // Ruta heredada. Se conserva para leer datos antiguos, pero la app V3.4
      // guarda el Parte en operationalParts como unica fuente canonica.
      match /parts/{partId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Fuente canonica de descansos para que el administrador pueda verlos en tiempo real.
    match /operationalBreaks/{breakId} {
      allow read: if signedIn()
                  && (resource.data.uid == request.auth.uid
                      || resource.data.operatorUid == request.auth.uid
                      || isAdmin());

      allow create, update: if signedIn()
                            && (request.resource.data.uid == request.auth.uid
                                || request.resource.data.operatorUid == request.auth.uid
                                || isAdmin());

      allow delete: if isAdmin();
    }

    match /operationalParts/{partId} {
      allow read: if signedIn()
                  && (resource.data.operatorUid == request.auth.uid
                      || isMechanicOrAdmin());

      // El propietario puede crear su propio Parte aunque el texto del rol
      // local estuviera desactualizado. Nunca puede crear Partes de otro UID.
      allow create: if signedIn()
                    && (request.resource.data.operatorUid == request.auth.uid
                        || isAdmin());

      // Permite sincronizar Partes actuales y reparar documentos antiguos
      // que todavia no tenian operatorUid.
      allow update: if signedIn()
                    && (isAdmin()
                        || (request.resource.data.operatorUid == request.auth.uid
                            && (!('operatorUid' in resource.data)
                                || resource.data.operatorUid == request.auth.uid)));

      allow delete: if isAdmin();

      match /services/{serviceId} {
        allow read: if signedIn()
                    && (resource.data.operatorUid == request.auth.uid
                        || isMechanicOrAdmin());

        allow create, update: if signedIn()
                              && ((isMechanic()
                                   && request.resource.data.mechanicUid == request.auth.uid)
                                  || isAdmin());

        allow delete: if isAdmin();
      }
    }

    match /services/{serviceId} {
      allow read: if signedIn()
                  && (resource.data.operatorUid == request.auth.uid
                      || isMechanicOrAdmin());

      allow create, update: if signedIn()
                            && ((isMechanic()
                                 && request.resource.data.mechanicUid == request.auth.uid)
                                || isAdmin());

      allow delete: if isAdmin();
    }

    match /fuelLoads/{loadId} {
      allow read: if isMechanicOrAdmin();

      allow create: if isMechanicOrAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.liters is number
                    && request.resource.data.liters > 0
                    && request.resource.data.shift in ['day', 'night'];

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /tanks/{tankId} {
      allow read: if isMechanicOrAdmin();
      allow create: if isAdmin();

      allow update: if isAdmin()
                    || (isMechanic()
                        && request.resource.data.capacityLiters == resource.data.capacityLiters
                        && request.resource.data.currentLiters >= 0
                        && request.resource.data.currentLiters <= resource.data.currentLiters);

      allow delete: if false;
    }


    // Señal global de limpieza para eliminar copias locales antiguas en todos los dispositivos.
    match /system/{documentId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }


    // Mensajeria privada. Solo el remitente y el destinatario pueden leer.
    match /directMessages/{messageId} {
      allow read: if hasProfile()
                  && profile().active == true
                  && request.auth.uid in resource.data.participantUids;

      allow create: if hasProfile()
                    && profile().active == true
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.recipientUid is string
                    && request.resource.data.recipientUid != request.auth.uid
                    && request.resource.data.participantUids is list
                    && request.resource.data.participantUids.size() == 2
                    && request.resource.data.participantUids.hasAll([
                         request.auth.uid,
                         request.resource.data.recipientUid
                       ])
                    && request.resource.data.conversationId is string
                    && request.resource.data.senderName is string
                    && request.resource.data.senderRole == profile().role
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.readBy is list
                    && request.auth.uid in request.resource.data.readBy
                    && request.resource.data.createdAtClient is string;

      // El destinatario solo puede agregar su UID al campo readBy.
      allow update: if hasProfile()
                    && profile().active == true
                    && request.auth.uid in resource.data.participantUids
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                    && request.resource.data.readBy is list
                    && request.resource.data.readBy.hasAll(resource.data.readBy)
                    && request.auth.uid in request.resource.data.readBy;

      allow delete: if false;
    }

    // Chat general interno. Todos los usuarios activos pueden leer y enviar.
    match /chatMessages/{messageId} {
      allow read: if hasProfile() && profile().active == true;

      allow create: if hasProfile()
                    && profile().active == true
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.senderName is string
                    && request.resource.data.senderRole == profile().role
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.createdAtClient is string;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
