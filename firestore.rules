rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }

    function isMechanic() {
      return hasProfile() && profile().role == 'mechanic';
    }

    function isMechanicOrAdmin() {
      return isMechanic() || isAdmin();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'operator';

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.role == resource.data.role);

      allow delete: if false;

      match /breaks/{breakId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if false;
      }

      match /parts/{partId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if false;
      }
    }

    match /operationalParts/{partId} {
      allow read: if signedIn()
                  && (resource.data.operatorUid == request.auth.uid
                      || isMechanicOrAdmin());

      allow create: if signedIn()
                    && (request.resource.data.operatorUid == request.auth.uid
                        || isAdmin());

      allow update: if signedIn()
                    && (resource.data.operatorUid == request.auth.uid
                        || isAdmin());

      allow delete: if false;

      match /services/{serviceId} {
        allow read: if signedIn()
                    && (resource.data.operatorUid == request.auth.uid
                        || isMechanicOrAdmin());

        allow create, update: if signedIn()
                              && ((isMechanic()
                                   && request.resource.data.mechanicUid == request.auth.uid)
                                  || isAdmin());

        allow delete: if false;
      }
    }

    match /services/{serviceId} {
      allow read: if signedIn()
                  && (resource.data.operatorUid == request.auth.uid
                      || isMechanicOrAdmin());

      allow create, update: if signedIn()
                            && ((isMechanic()
                                 && request.resource.data.mechanicUid == request.auth.uid)
                                || isAdmin());

      allow delete: if false;
    }

    match /fuelLoads/{loadId} {
      allow read: if isMechanicOrAdmin();

      allow create: if isMechanicOrAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.liters is number
                    && request.resource.data.liters > 0
                    && request.resource.data.shift in ['day', 'night'];

      allow update, delete: if false;
    }

    match /tanks/{tankId} {
      allow read: if isMechanicOrAdmin();

      allow create: if isAdmin();

      allow update: if isAdmin()
                    || (isMechanic()
                        && request.resource.data.capacityLiters == resource.data.capacityLiters
                        && request.resource.data.currentLiters >= 0
                        && request.resource.data.currentLiters <= resource.data.currentLiters);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
